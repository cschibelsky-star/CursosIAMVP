# Configuração do Ambiente — Cursos IA MVP (Vitrine IA Pro)

# Aplicação
APP_ENV=homologation
PORT=8894

# Banco de Dados (MariaDB / MySQL)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cursos_ia_mvp
DB_USERNAME=cursos_ia
DB_PASSWORD=cursos_ia_hml
MARIADB_ROOT_PASSWORD=cursos_ia_root_hml

# Módulo de Inteligência Artificial / Broker
AI_ENABLED=1
AI_MODE=broker
AI_PROJECT_ID=cursos-ia-mvp
AI_BROKER_URL=http://vitrine_core_web_hml/api/internal/centro-ia/execute
AI_BROKER_TOKEN=coloque_aqui_seu_token_secreto

# OpenAI / Modelo Direto (Opcional se AI_MODE=direct)
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
